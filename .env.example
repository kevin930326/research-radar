# 複製成 .env 後填入真正的值；.env 不進 repo
# 沒有任何程式把 .env 的值交給 radar（compose 的 env_file 只載入 .env.radar、uv run 也不載入）；
# 這裡只是列出變數名稱，本機 compose 的非秘密值直接寫在 compose.yaml。
# （Docker Compose 本身預設會讀同資料夾的 .env 做 compose.yaml 裡 ${...} 的變數替換；
# compose.yaml 沒有用到 ${...}，所以不影響容器拿到的值。）
# 容器（api、worker）只從 .env.radar 讀 RADAR_* 秘密（compose 的 env_file，檔案不存在也照樣起得來；
# 見 .env.radar.example、ADR-0024）；這個 .env 的值不會被載入容器。
# 空白的欄位視為沒設定：必填的會啟動失敗，選填的用括號裡的預設值。
OPENALEX_API_KEY=

# 應用程式角色（radar_app）的資料庫連線字串（必填）。本機 compose 已經直接寫在 compose.yaml，不從這裡讀。
DATABASE_URL=
# 資料庫連線逾時秒數（預設 3，最小 2）
RADAR_DATABASE_CONNECT_TIMEOUT=
# 遷移用的擁有者角色連線字串：只給 radar migrate，api、worker 不設
RADAR_MIGRATION_DATABASE_URL=
# 每個行程最多同時佔用幾條資料庫連線（預設 api 8、worker 6、每個 CLI 行程 2）
# worker 的拆法：佇列連線池最多 2＋監聽 1＋其餘給應用程式連線池（預設 6 是 2＋1＋3；不能小於 3）；
# CLI 最多 2（radar enqueue 只開佇列連線池）
RADAR_API_DATABASE_POOL_SIZE=
RADAR_WORKER_DATABASE_POOL_SIZE=
RADAR_CLI_DATABASE_POOL_SIZE=
# api 監聽的位址與連接埠（預設 0.0.0.0、8000）
RADAR_API_HOST=
RADAR_API_PORT=
# 收到 SIGTERM 後等請求做完的秒數（預設 10）；compose 的 stop_grace_period 要比它長
RADAR_API_SHUTDOWN_GRACEFUL_TIMEOUT=
# 收到 SIGTERM 後等工作做完的秒數（預設 30）；compose 的 stop_grace_period 要比它長
RADAR_WORKER_SHUTDOWN_GRACEFUL_TIMEOUT=
# worker 同時跑幾個工作（預設 2，1 到 8）
RADAR_WORKER_CONCURRENCY=
# worker 連不上資料庫或自己停了之後，隔幾秒重開（預設 10）
RADAR_WORKER_RESTART_INTERVAL=
# worker 超過幾秒沒向資料庫報到，就把它手上執行中的工作交給 sweep 重試（預設 60，最小 30）
RADAR_WORKER_STALLED_SECONDS=
# 工作失敗後最多再試幾次（預設 3；0＝不重試），第 n 次前等 n × RADAR_JOB_RETRY_WAIT 秒（預設 30）；
# worker 不在了、由 sweep 重試的卡住工作也算在同一個上限裡
RADAR_JOB_MAX_RETRIES=
RADAR_JOB_RETRY_WAIT=
# 一筆每週更新從建立起累計失敗幾次就標成失敗、不再補排（預設 8，1 到 100）；工作重試、sweep 補排
# 都一起算，額度停下不算。只算丟出錯誤的失敗（worker 被砍掉不算）。預設 8 是照工作重試 3 次、
# 每次等 30 秒算的（約 2 小時），改 RADAR_JOB_MAX_RETRIES／RADAR_JOB_RETRY_WAIT 時要一起看。
# 標成失敗後下一次排程會開新的一筆從頭抓
RADAR_WEEKLY_UPDATE_MAX_FAILURES=
# 排程跑完後通知的心跳網址（healthchecks.io 之類，選填；沒設就只記警告）。一個排程一個：
# RADAR_HEARTBEAT_URL_<排程名稱>，排程名稱的連字號換成底線
RADAR_HEARTBEAT_URL_SWEEP=
RADAR_HEARTBEAT_URL_WEEKLY_UPDATE=
# 送心跳的逾時秒數（預設 5）與最多嘗試次數（預設 3）
RADAR_HEARTBEAT_TIMEOUT=
RADAR_HEARTBEAT_ATTEMPTS=
# 心跳重試的等待秒數：從 INITIAL（預設 1）開始每次加倍、最多 MAX（預設 10）；
# 對方回 Retry-After 時，不超過 RETRY_AFTER_MAX 秒（預設 30）就照它等；超過就這一輪不再重試、
# 記成心跳失敗（不提早重送）
RADAR_HEARTBEAT_RETRY_WAIT_INITIAL=
RADAR_HEARTBEAT_RETRY_WAIT_MAX=
RADAR_HEARTBEAT_RETRY_AFTER_MAX=
# 領域設定（journals.yaml、openalex.yaml）的資料夾（預設是工作目錄下的 config）
RADAR_CONFIG_DIR=
# OpenAlex 的 API key（抓取論文時必填；呼叫、速率、額度設定在 config/openalex.yaml）。
# 程式（radar）讀的是這一個；上面的 OPENALEX_API_KEY 只有 spikes/ 的腳本在用。
# 兩個可以填同一把 key。
RADAR_OPENALEX_API_KEY=
# 物件儲存（R2；本機是 RustFS，S3 相容）：存原始資料時必填。
# 端點網址（例如 http://127.0.0.1:9000）、區域（R2 是 auto）、bucket、金鑰
RADAR_OBJECT_STORE_ENDPOINT_URL=
RADAR_OBJECT_STORE_REGION=
RADAR_OBJECT_STORE_BUCKET=
RADAR_OBJECT_STORE_ACCESS_KEY_ID=
RADAR_OBJECT_STORE_SECRET_ACCESS_KEY=
# 物件儲存的逾時秒數（預設 10）與最多嘗試次數（預設 3，含第一次）
RADAR_OBJECT_STORE_TIMEOUT=
RADAR_OBJECT_STORE_ATTEMPTS=
# 物件儲存重試的等待秒數：從 INITIAL（預設 0.5）開始每次加倍、最多 MAX（預設 5），
# 再加 0～JITTER 秒（預設 0.5）；對方回 Retry-After 時照它等，要等的超過 RETRY_AFTER_MAX 秒
# （預設 30）就不再重試、這次存取算失敗（不提早重送）
RADAR_OBJECT_STORE_RETRY_WAIT_INITIAL=
RADAR_OBJECT_STORE_RETRY_WAIT_MAX=
RADAR_OBJECT_STORE_RETRY_WAIT_JITTER=
RADAR_OBJECT_STORE_RETRY_AFTER_MAX=
# 付費全文與上傳的 PDF 內容可不可以送雲端的 LLM／向量化服務（預設 false＝不可以；true 才放行）。
# 標題、OpenAlex／Crossref 摘要與 CC BY／CC BY-SA／CC0 的 OA 全文不受影響，一律可以送；
# Semantic Scholar 的摘要還沒取得授權，設成 true 也不會放行（ADR-0029）
RADAR_PAYWALLED_FULLTEXT_LLM=
# Anthropic 的 API key（呼叫 LLM 時必填；只放 .env.radar，不進 repo）
RADAR_ANTHROPIC_API_KEY=
# 呼叫 Anthropic 的逾時秒數（預設 60，1 到 600）與最多嘗試次數（預設 3，1 到 10，含第一次）
RADAR_ANTHROPIC_TIMEOUT=
RADAR_ANTHROPIC_ATTEMPTS=
# Anthropic 重試的等待秒數（只重試逾時、限流、服務端錯誤、連線錯誤）：從 INITIAL（預設 1）開始
# 每次加倍、最多 MAX（預設 10），再加 0～JITTER 秒（預設 1）；對方回 Retry-After 時照它等，
# 要等的超過 RETRY_AFTER_MAX 秒（預設 60）就不再重試、這次呼叫算暫時性失敗（不提早重送）
RADAR_ANTHROPIC_RETRY_WAIT_INITIAL=
RADAR_ANTHROPIC_RETRY_WAIT_MAX=
RADAR_ANTHROPIC_RETRY_WAIT_JITTER=
RADAR_ANTHROPIC_RETRY_AFTER_MAX=
