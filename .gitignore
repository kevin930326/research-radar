# =========================================================
# 機密與環境變數（安全紅線：絕不 commit）
# =========================================================
.env
.env.*
!.env.example
# 容器讀的 RADAR_* 秘密（ADR-0024）；只有說明用的範例進 repo
.env.radar
!.env.radar.example
*.pem
*.key
secrets/

# =========================================================
# 使用者上傳的 PDF 與實驗室資料（安全紅線：絕不 commit）
# =========================================================
*.pdf
*.PDF
uploads/
data/
**/uploads/
**/data/
# 標註試算表（真的標註檔不 commit；範例檔在 tests/fixtures/ 由下面的放行規則放行）
*.xlsx
# 測試用的假資料若需要進 repo，放在 tests/fixtures/ 並用下面這行放行
!tests/fixtures/**

# 本機資料庫檔與備份
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
backups/
# radar backup 的加密備份檔（age，Story 3.18、ADR-0051）：不進 repo
*.age
# age 的私鑰檔（搬家文件建議放在 repo 以外的 ~/.config/age/radar-backup.agekey）：萬一放進來也不進 repo
*.agekey

# =========================================================
# Python
# =========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 虛擬環境
.venv/
venv/
env/
.python-version

# 測試與型別檢查
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
# Hypothesis（性質測試）在本機存的範例資料庫
.hypothesis/
.ipynb_checkpoints/

