{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Radar",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "行程活著就回 200；不碰資料庫。",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz"
                }
              }
            }
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "資料庫連得上、遷移版本不落後回 200，否則 503（AD-15）。\n\n同步函式，FastAPI 會放到執行緒池跑。",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "還沒準備好",
            "content": {
              "application/json": {
                "example": {
                  "status": "not_ready"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Me",
        "description": "我是誰：成員 ID 與顯示名稱（不含 email）；沒登入 401。",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout",
        "description": "登出：刪掉 cookie 對到的 session（過期的也刪）、清掉 cookie；沒登入也回 204。",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/fake-login": {
      "get": {
        "summary": "Fake Login Options",
        "description": "假登入的模式與可以選的成員（試用環境不能選人，清單是空的）。",
        "operationId": "fake_login_options",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FakeLoginOptionsResponse"
                }
              }
            }
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Fake Login",
        "description": "假登入：確認身分、建 session、設 cookie，回站內的轉回路徑。",
        "operationId": "fake_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FakeLoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FakeLoginResultResponse"
                }
              }
            }
          },
          "default": {
            "description": "錯誤（RFC 9457）",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FakeLoginBody": {
        "properties": {
          "member_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Member Id"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FakeLoginBody",
        "description": "假登入的請求內容：選的成員（只有開發環境用得到）、登入後要轉回的路徑。"
      },
      "FakeLoginMode": {
        "type": "string",
        "enum": [
          "pick_member",
          "access_admin"
        ],
        "title": "FakeLoginMode",
        "description": "假登入怎麼確認身分。"
      },
      "FakeLoginOptionsResponse": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/FakeLoginMode"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            },
            "type": "array",
            "title": "Members"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "members"
        ],
        "title": "FakeLoginOptionsResponse",
        "description": "假登入的模式與可以選的成員（試用環境不能選人，清單是空的）。"
      },
      "FakeLoginResultResponse": {
        "properties": {
          "next": {
            "type": "string",
            "title": "Next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "next"
        ],
        "title": "FakeLoginResultResponse",
        "description": "假登入成功：登入後要轉回的站內路徑。"
      },
      "MemberResponse": {
        "properties": {
          "member_id": {
            "type": "string",
            "format": "uuid",
            "title": "Member Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "member_id",
          "display_name"
        ],
        "title": "MemberResponse",
        "description": "一位成員：ID 與顯示名稱（不含 email）。"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "enum": [
              "admin_member_missing",
              "internal_error",
              "login_rejected",
              "method_not_allowed",
              "not_authenticated",
              "not_found",
              "origin_rejected",
              "request_invalid",
              "request_rejected"
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "description": "錯誤回應（RFC 9457）。`code` 只會是 api 會回的代碼（`PROBLEM_STATUS` 的鍵）。"
      }
    }
  }
}
